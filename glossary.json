  "characters": {
    "我": { "jp_name": "私", "first_person": "俺", "second_person": "あんた/お前/あなた", "style": "クールでツッコミ気質な青年（2026年の隕石ハンター）。独白・通常時は『俺』、目上・フォーマルな場のみ丁寧語。" },
    "即墨离": { "jp_name": "ジモリー", "first_person": "私", "second_person": "先輩（学长）", "style": "黒猫に変身できる現代の後輩少女。健気で少し小悪魔な後輩口調（〜ですよ、〜だもん、先輩！）。" },
    "格蕾特": { "jp_name": "グレーテル", "first_person": "私/あたし", "second_person": "相棒/錬金術師/キミ", "style": "好奇心旺盛で元気溌剌な衛兵隊の銃士少女。フランクなタメ口（〜だよ！、〜しようよ！）。" },
    "奥罗拉": { "jp_name": "オーロラ", "first_person": "私", "second_person": "錬金術師閣下/あなた", "style": "車椅子の王女にして街の『女神』。気高く上品なお嬢様・王女口調（〜ですわ、〜ますの、〜ですね）。" },
    "茜茜": { "jp_name": "アカネ", "first_person": "私", "second_person": "旦那様/錬金術師様", "style": "怪力だが素直で一生懸命な酒場娘・メイド。少し照れ屋な丁寧語（〜です！、あの、旦那様……）。" },
    "奈奈": { "jp_name": "ナナ", "first_person": "私", "second_person": "旦那様/錬金術師様", "style": "元貴族令嬢（ヘレナ・ヴォルフゲン）で頭が切れる酒場娘。知的で落ち着いたお姉さん・秘書風の丁寧語（〜ですね、〜かしら）。" },
    "露娜": { "jp_name": "ルナ", "first_person": "私", "second_person": "錬金術師/あなた", "style": "夢と地下に囚われた銀髪の少女。純粋で浮世離れした静かな口調（〜なの、〜だよ、〜かな……）。" },
    "塔纳托斯": { "jp_name": "タナトス", "first_person": "私", "second_person": "お前/貴様/錬金術師", "style": "『ヨグ＝ソトースの庭』の死神ヒロイン。凛とした誇り高いツンデレ口調（〜だ、〜わ、〜じゃない）。" },
    "修普洛斯": { "jp_name": "ヒュプロス", "first_person": "ぼく", "second_person": "錬金術師", "style": "眠りの神（愛称：シューちゃん）。常に眠そうでふわふわした口調（ふわぁ……、〜だよぉ、〜なの）。" },
    "霓克斯": { "jp_name": "ニュクス", "first_person": "私", "second_person": "キミ/お前/錬金術師", "style": "夜の女神。豪快で余裕たっぷりな姉御口調（〜じゃないの！、〜わよ！）。" },
    "星雪": { "jp_name": "星雪", "first_person": "オラ/タヌ", "second_person": "旦那/錬金術師殿", "style": "タヌキ商人（前作商人の双子の兄）。愛嬌のある商人口調（〜だポン、〜だよぉ）。" },
    "持笛者": { "jp_name": "笛奏者", "first_person": "私/我", "second_person": "お前/人間", "style": "悲劇を劇として愉しむ黒幕。芝居がかった優雅で冷酷な口調（〜だね、〜かな？）。" },
    "K": { "jp_name": "K", "first_person": "僕/小生", "second_person": "君/錬金術師", "style": "ギャンブラー風のトリックスター紳士口調（〜だよ、〜かい？）。" },
    "赫尔墨斯": { "jp_name": "ヘルメス", "first_person": "私", "second_person": "お前/錬金術師", "style": "冷徹で傲慢な大賢者口調（〜だ、〜である）。" },
    "丽卡妲": { "jp_name": "リカダ", "first_person": "私", "second_person": "あなた/錬金術師", "style": "ヘーマン衛隊の女性隊長。生真面目で凛々しい軍人口調（〜です、〜だ）。" },
    "韩赛尔": { "jp_name": "ハンゼル", "first_person": "俺", "second_person": "我が友/あんた", "style": "ヘーマン衛隊の副隊長（グレーテルの兄）。豪快で頼れる兄貴分口調（〜だ、〜だな、我が友よ！）。" },
    "老金": { "jp_name": "キング", "first_person": "俺", "second_person": "若いの/あんた/相棒", "style": "太陽酒場のマスター。気っ風のいい親父口調（〜だぜ、〜だな！）。" },
    "乌鸫": { "jp_name": "クロウタドリ", "first_person": "私", "second_person": "錬金術師様/あなた", "style": "雑貨屋の女主人。落ち着いて艶のあるお姉さん口調（〜ですよ、〜かしら）。" },
    "依黛拉": { "jp_name": "イデラ", "first_person": "私", "second_person": "あんた/錬金術師", "style": "リービッヒ家の化学者少女（コミュ障）。ツンツンした自信家口調（〜よ！、〜だわ！）。" },
    "蒲鹿铃": { "jp_name": "浦越鈴", "first_person": "私", "second_person": "錬金術師様/あなた", "style": "東洋出身の書店主。おっとり丁寧だが薄い本が見つかると慌てる文学少女（〜です、〜ますわ）。" },
    "翡雀": { "jp_name": "翡雀", "first_person": "私", "second_person": "パートナー/錬金術師", "style": "銀のカギの女商人。妖艶で抜け目ない口調（〜わ、〜よ、親愛なるパートナー）。" },
    "粉豆": { "jp_name": "ピンクマメ", "first_person": "ウサ/あたし", "second_person": "人間/錬金術師", "style": "銀のカギの強気なウサギ族少女。『ウサギの餌にしてやる！』が口癖（〜よ！、〜なんだから！）。" },
    "豆粉": { "jp_name": "マメコ", "first_person": "ウサ/私", "second_person": "人間さん/錬金術師様", "style": "銀のカギの臆病なウサギ族少女（ひ、ひぃぃ……、〜だもん……）。" },
    "路德维希大公": { "jp_name": "ルートヴィヒ大公", "first_person": "私/余", "second_person": "マスター/錬金術師殿", "style": "威厳ある君主口調（〜である、〜だ、〜たまえ）。" },
    "毛奇": { "jp_name": "モーチ", "first_person": "私/手前", "second_person": "あなた/錬金術師殿", "style": "大公府の執事。慇懃無礼で常に硬い敬語（〜です、〜ます、〜でございます）。" },
    "古登": { "jp_name": "コトン", "first_person": "私", "second_person": "我が友/あなた", "style": "大公府のマッドドクター。知的で紳士的な丁寧語（〜ですね、〜ではありませんか？）。" },
    "芙华茨基夫人": { "jp_name": "フヴァツキー夫人", "first_person": "私", "second_person": "あなた/錬金術師", "style": "銀のカギを統べる神秘主義の夫人。威厳あるマダム口調（〜わ、〜ね）。" }
  }
}
